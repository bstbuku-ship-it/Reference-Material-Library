{
  "manifest_version": 3,
  "name": "素材参考库",
  "version": "1.6.0",
  "description": "把灵感收进自己的素材库：分类、九宫格、截图画廊一应俱全，原图只存本地硬盘。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "打开素材参考库"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://i.ytimg.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "key": ""
}
